# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example se versiona como documentación del deploy
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# spec interno — NO publicar (contiene notas de proyecto privado)
specs/

# testing / quality
/playwright-report
/test-results
/.lighthouseci
.swc

# CV: los PDF se generan con `make -C cv`. La copia que sirve el sitio vive en
# public/cv/ y esa sí se versiona.
/cv/*.pdf
/cv/*.aux
/cv/*.log
/cv/*.out

# CV dirigidos a una vacante concreta. Fuera de git a propósito: este repo es
# público, y ni el nombre de la empresa ni una carta que reconoce un requisito
# no cumplido deberían poder leerlos otros reclutadores.
/cv/dirigidos/
